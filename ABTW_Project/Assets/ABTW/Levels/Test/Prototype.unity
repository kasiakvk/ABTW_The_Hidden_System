%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!29 &1
OcclusionCullingSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_OcclusionBakeSettings:
    smallestOccluder: 5
    smallestHole: 0.25
    backfaceThreshold: 100

# ── PROTOTYPE TEST SCENE ──────────────────────────────────────────────────
# ABTW: The Hidden System — Developer Test Scene
# Purpose: Rapid system testing without full level geometry
# NOT included in release build
#
# Use this scene to test:
#   - Individual anomaly triggers
#   - Notebook UI open/close/record/wait
#   - Perception Mode activation timer
#   - Echo spawn after early record
#   - Trio activation after wait
#   - Memory Walk enter/exit
#   - Save/Load cycle
#   - Lighting profile transitions
#
# Layout (flat plane + minimal geometry):
#   - White floor plane (50x50)
#   - 4 test trigger cubes (one per anomaly type)
#   - Debug UI overlay (show all system states)
#   - Free camera mode enabled
#
# Required GameObjects:
#   - Player_Astra (test spawn point: 0,0,0)
#   - CameraRig (free camera mode)
#   - TestTrigger_Shadow (BoxCollider, ShadowDelayAnomaly)
#   - TestTrigger_Light (BoxCollider, LightInstabilityAnomaly)
#   - TestTrigger_Symbol (BoxCollider, SymbolFragmentAnomaly)
#   - TestTrigger_Sound (BoxCollider, SoundEchoAnomaly)
#   - NotebookCanvas (UI)
#   - DebugOverlay (shows: Awareness, Clarity, Connection, Timing, Stability)
#   - All Systems (GameManager, PerceptionSystem, etc.)
#
# Debug Keys (test scene only):
#   F1 — force Perception Mode
#   F2 — force Trio Activation
#   F3 — force Echo spawn
#   F4 — force Memory Walk
#   F5 — cycle Lighting Profile
#   F9 — reset all systems
#   F10 — print all system states to console