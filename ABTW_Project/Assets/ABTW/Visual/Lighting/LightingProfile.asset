%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: lighting_profile_guid, type: 3}
  m_Name: LightingProfile
  # ABTW Lighting Profile — soft, perception-reactive lighting
  # Rule: Light is never harsh. It whispers, not shouts.

  profiles:

    - id: MORNING
      displayName: Morning
      ambientColor: [0.85, 0.88, 0.95, 1.0]
      ambientIntensity: 0.7
      sunColor: [1.0, 0.97, 0.88, 1.0]
      sunIntensity: 0.9
      sunAngle: 25.0
      fogEnabled: false
      fogColor: [0.88, 0.90, 0.95, 1.0]
      fogDensity: 0.0
      shadowStrength: 0.4
      shadowSoftness: 0.8
      perceptionMultiplier: 0.8
      anomalyVisibility: 0.6
      emotionalTone: QuietAwareness

    - id: AFTERNOON
      displayName: Afternoon
      ambientColor: [0.92, 0.90, 0.82, 1.0]
      ambientIntensity: 0.85
      sunColor: [1.0, 0.95, 0.75, 1.0]
      sunIntensity: 1.1
      sunAngle: 55.0
      fogEnabled: false
      fogColor: [0.90, 0.88, 0.80, 1.0]
      fogDensity: 0.0
      shadowStrength: 0.5
      shadowSoftness: 0.6
      perceptionMultiplier: 1.0
      anomalyVisibility: 0.8
      emotionalTone: WarmSocialRhythm

    - id: SUNSET
      displayName: Sunset
      ambientColor: [0.95, 0.75, 0.55, 1.0]
      ambientIntensity: 0.65
      sunColor: [1.0, 0.65, 0.35, 1.0]
      sunIntensity: 0.75
      sunAngle: 10.0
      fogEnabled: true
      fogColor: [0.90, 0.70, 0.55, 1.0]
      fogDensity: 0.015
      shadowStrength: 0.6
      shadowSoftness: 0.9
      perceptionMultiplier: 1.2
      anomalyVisibility: 1.0
      emotionalTone: TransitionEmotionalShift

    - id: NIGHT
      displayName: Night
      ambientColor: [0.12, 0.14, 0.22, 1.0]
      ambientIntensity: 0.3
      sunColor: [0.20, 0.22, 0.40, 1.0]
      sunIntensity: 0.15
      sunAngle: -20.0
      fogEnabled: true
      fogColor: [0.10, 0.12, 0.20, 1.0]
      fogDensity: 0.025
      shadowStrength: 0.8
      shadowSoftness: 0.5
      perceptionMultiplier: 1.8
      anomalyVisibility: 1.4
      emotionalTone: PerceptionDepthSilence

    - id: RAIN
      displayName: Rain
      ambientColor: [0.55, 0.58, 0.65, 1.0]
      ambientIntensity: 0.5
      sunColor: [0.60, 0.62, 0.70, 1.0]
      sunIntensity: 0.4
      sunAngle: 45.0
      fogEnabled: true
      fogColor: [0.50, 0.52, 0.60, 1.0]
      fogDensity: 0.04
      shadowStrength: 0.3
      shadowSoftness: 1.0
      perceptionMultiplier: 1.3
      anomalyVisibility: 1.1
      emotionalTone: ReflectionInstability

  # Transition settings
  transitionDuration: 3.0
  transitionCurve: SmoothStep

  # Perception Mode overlay
  perceptionModeDesaturation: 0.15
  perceptionModeVignetteStrength: 0.2
  perceptionModeBloomIntensity: 0.3
  perceptionModeColorShift: [0.92, 0.95, 1.05]