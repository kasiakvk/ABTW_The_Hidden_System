%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!1 &100000
GameObject:
  m_ObjectHideFlags: 0
  m_Name: CameraRig
  m_IsActive: 1
--- !u!4 &400000
Transform:
  m_GameObject: {fileID: 100000}
  m_LocalPosition: {x: 0, y: 0, z: 0}
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1}
  m_LocalScale: {x: 1, y: 1, z: 1}
--- !u!114 &114000001
MonoBehaviour:
  m_GameObject: {fileID: 100000}
  m_Script: {fileID: 11500000, guid: camera_controller_guid, type: 3}
  m_Name: CameraController

  # Follow settings
  followTarget: Player_Astra
  followDistance: 4.5
  followHeight: 1.8
  followSmoothTime: 0.12

  # Rotation
  mouseSensitivity: 1.0
  invertY: false
  minVerticalAngle: -30.0
  maxVerticalAngle: 60.0

  # Perception Mode camera
  perceptionFOVNormal: 65.0
  perceptionFOVActive: 60.0
  perceptionFOVTransitionSpeed: 2.0
  perceptionZoomAmount: 0.15
  perceptionZoomSpeed: 1.5

  # Cinematic mode (cutscenes / Memory Walk)
  cinematicFOV: 50.0
  cinematicSmoothTime: 0.3

  # Memory Walk camera
  memoryWalkDesaturation: 0.6
  memoryWalkVignetteStrength: 0.4

--- !u!20 &20000001
Camera:
  m_ObjectHideFlags: 0
  m_Enabled: 1
  serializedVersion: 2
  m_ClearFlags: 1
  m_BackGroundColor: {r: 0.09, g: 0.09, b: 0.12, a: 0}
  m_NormalizedViewPortRect:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  near clip plane: 0.1
  far clip plane: 500
  field of view: 65
  orthographic: 0
  orthographic size: 5
  m_Depth: -1
  m_RenderingPath: -1
  m_TargetTexture: {fileID: 0}
  m_TargetDisplay: 0
  m_TargetEye: 3
  m_HDR: 1
  m_AllowMSAA: 1
  m_AllowDynamicResolution: 0
  m_ForceIntoRT: 0
  m_OcclusionCulling: 1
  m_StereoConvergence: 10
  m_StereoSeparation: 0.022

# ── Camera Design Notes ───────────────────────────────────────────────────
# 3rd person, cinematic, always slightly behind and above Astra.
# Camera is a storytelling tool — it frames the world, not the action.
# During Perception Mode: subtle FOV reduction + micro zoom toward anomaly.
# During Memory Walk: desaturated, slight blur, no player input on camera.
# NEVER: shaky cam, dramatic swoops, combat-style tracking.