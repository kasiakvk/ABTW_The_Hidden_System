%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!1 &100000
GameObject:
  m_ObjectHideFlags: 0
  m_Name: ShadowGlitch
  m_IsActive: 1
--- !u!4 &400000
Transform:
  m_GameObject: {fileID: 100000}
  m_LocalPosition: {x: 0, y: 0, z: 0}
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1}
  m_LocalScale: {x: 1, y: 1, z: 1}
--- !u!114 &114000001
MonoBehaviour:
  m_GameObject: {fileID: 100000}
  m_Script: {fileID: 11500000, guid: shadow_delay_anomaly_guid, type: 3}
  m_Name: ShadowDelayAnomaly

  # Shadow delay configuration
  delaySeconds: 0.4
  evolutionMultiplier: 1.5
  glitchColor: [0.4, 0.4, 0.8, 0.6]
  activationColor: [1.0, 0.85, 0.2, 0.9]

  # Detection
  detectionRadius: 3.0
  requiresDirectObservation: true
  observationAngleThreshold: 45.0

  # State
  currentState: Hidden
  isEchoVersion: false
  echoIntensityMultiplier: 0.4

  # Notebook integration
  patternId: "SYM_001"
  notebookEntryId: "ENTRY_001"

--- !u!114 &114000002
MonoBehaviour:
  m_GameObject: {fileID: 100000}
  m_Script: {fileID: 11500000, guid: glow_effect_guid, type: 3}
  m_Name: GlowEffect
  glowType: None
  autoStart: false
  transitionSpeed: 1.5
  enablePulse: true
  pulseSpeed: 1.0
  pulseAmplitude: 0.15

--- !u!65 &65000001
BoxCollider:
  m_GameObject: {fileID: 100000}
  m_Enabled: 1
  serializedVersion: 2
  m_IsTrigger: 1
  m_Size: {x: 2.0, y: 3.0, z: 0.1}
  m_Center: {x: 0, y: 1.5, z: 0}

# ── Shadow Glitch Notes ───────────────────────────────────────────────────
# This prefab represents a shadow that moves 0.4s after its source.
# It is the first anomaly Astra encounters in East Corridor.
# Visual: projected shadow mesh with delayed position update.
# The shadow is subtle — player can miss it on first pass.
# On detection: GlowEffect transitions to Subtle, then Forming.
# On Trio activation: GlowEffect transitions to Activation (warm gold).
# Echo version: reduced intensity, single occurrence, no evolution.